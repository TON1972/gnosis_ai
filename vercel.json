{
  "version": 2,
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/process-emails",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/trpc/:trpc",
      "destination": "/api/trpc/[trpc]"
    },
    {
      "source": "/api/((?!trpc/).*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}